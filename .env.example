# نمونهٔ توسعه؛ رمز واقعی را فقط در فایل .env محلی قرار دهید.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://productor:YOUR_PASSWORD@localhost:5432/productor?sslmode=disable
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3002
PUBLIC_API_URL=http://localhost:8080
UPLOAD_DIR=uploads
OTP_MODE=development
# OTP_HASH_SECRET در توسعه به‌صورت خودکار ساخته می‌شود.
BOOTSTRAP_ADMIN_PHONES=
SESSION_COOKIE_NAME=productor_session
COOKIE_SECURE=false
